{
  "name": "comic-reader",
  "version": "0.0.1",
  "author": "Tobias Dapolonia",
  "homepage": "https://apollonius22.github.io/Comic/",
  "description": "An immersive Ionic and Angular comic-book reader with responsive page flips.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build && node scripts/set-pages-base-href.mjs /Comic/",
    "build:full": "npm run export:pdf && npm run export:gif && ng build && npm run copy:gif",
    "watch": "ng build --watch --configuration development",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:gif": "node scripts/export-gif.mjs",
    "copy:gif": "node scripts/copy-gif-export.mjs",
    "check:assets": "node scripts/check-comic-assets.mjs",
    "outline:pages": "node scripts/apply-page-outline.mjs",
    "normalize:pages": "node scripts/normalize-pages.mjs",
    "optimize:pages": "node scripts/optimize-comic-pages.mjs",
    "split:inside": "node scripts/split-inside-cover.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "verify": "npm run check:assets && npm run lint && npm run test:ci && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor/core": "8.3.1",
    "@ionic/angular": "^8.0.0",
    "page-flip": "^2.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@capacitor/cli": "8.3.1",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "gifenc": "^1.0.3",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.0"
  }
}
